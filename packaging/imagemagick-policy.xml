<?xml version="1.0" encoding="UTF-8"?>
<!--
  Hardened ImageMagick security policy for SageThumbs 2K.

  The thumbnail tier reads a raster image and writes PNG to stdout. The Convert
  tier reads only SageThumbs' own in-memory PNG and writes one explicitly named,
  supported raster coder. Both run in isolated child processes. This policy
  disables everything that carries the worst CVE history or could shell out /
  touch the network, and bounds resources — defense in depth on top of the
  subprocess kill-timeout in decode.rs. ImageMagick reads this file from its own
  directory (next to magick.exe in the install dir).
-->
<policymap>
  <!-- Resource ceilings (belt-and-suspenders with the subprocess watchdog).
       `time` is ImageMagick's ELAPSED-time limit, so it tracks the watchdog's wall-clock
       backstop rather than its 20 s CPU budget: a lower value here would abort a decode
       that is merely waiting for a busy machine to schedule it, which is the bug the CPU
       budget exists to prevent. Runaway work is still caught by the CPU budget first. -->
  <policy domain="resource" name="memory" value="512MiB"/>
  <policy domain="resource" name="map" value="1GiB"/>
  <policy domain="resource" name="area" value="512MP"/>
  <policy domain="resource" name="disk" value="2GiB"/>
  <policy domain="resource" name="time" value="120"/>
  <policy domain="resource" name="list-length" value="256"/>

  <!-- Document / PostScript / vector coders: never needed, historically the
       most dangerous (Ghostscript RCE class). SVG is handled by resvg, not here. -->
  <policy domain="coder" rights="none" pattern="{PS,PS2,PS3,EPS,EPS2,EPS3,EPT,EPT2,EPT3,EPI,EPSF,EPSI,PDF,PDFA,EPDF,POCKETMOD,XPS,AI}"/>
  <policy domain="coder" rights="none" pattern="{SVG,MSVG,RSVG}"/>

  <!-- Scripting / indirection / network / interactive coders. -->
  <policy domain="coder" rights="none" pattern="{MSL,MVG,MAGICK,SCRIPT}"/>
  <policy domain="coder" rights="none" pattern="{URL,HTTPS,HTTP,FTP,FILE,EPHEMERAL,INLINE,DATA,SHOW,WIN,X,CLIPBOARD,SCREENSHOT}"/>
  <policy domain="coder" rights="none" pattern="{LABEL,CAPTION,TEXT,TXT,SPARSE-COLOR,PANGO,HTM,HTML,SHTML,DFONT,OTF,PFA,PFB,TTC,TTF}"/>

  <!-- Block external delegate programs (Ghostscript, ffmpeg, etc.). Built-in
       module coders (libheif/libwebp/openjpeg, etc.) are NOT delegates and keep
       working. -->
  <policy domain="delegate" rights="none" pattern="*"/>

  <!-- No indirect file reads via @filename, and no writing arbitrary modules. -->
  <policy domain="path" rights="none" pattern="@*"/>
  <policy domain="module" rights="none" pattern="{HTTPS,URL}"/>
</policymap>
